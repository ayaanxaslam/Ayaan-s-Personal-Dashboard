# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored — never commit real credentials.

# Supabase → Project Settings → API (or "API Keys")
# The anon / publishable key is designed to be public; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# OpenAI → https://platform.openai.com/api-keys  (server-side only; optional)
# Without it the dashboard works normally and AI insights show a setup message.
OPENAI_API_KEY=

# Optional: any model your OpenAI account can use with the Responses API.
OPENAI_MODEL=gpt-5-mini

# Not needed by this app. Everything runs as the signed-in user under RLS.
# Do NOT add the service-role key unless a future server-only feature requires it,
# and never prefix it with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
